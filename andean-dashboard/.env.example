# Copy to .env for local development. Never commit .env.
APP_ENV=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
DATABASE_URL=sqlite:///./dashboard.db
BASE_URL=http://localhost:8000

# Microsoft Entra ID app registration (ask Andean IT; see README)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: comma-separated
ALLOWED_EMAIL_DOMAINS=
ADMIN_EMAILS=

# Local only: lets you sign in without Microsoft while developing
DEV_LOGIN=1

# Slack app (see slack-manifest.yml and the README)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Socket Mode token (xapp-...), local development only
SLACK_APP_TOKEN=
# Your User OAuth Token (xoxp-...) so task-panel replies post as you (prototype: one person)
SLACK_USER_TOKEN=

# Notion internal integration (see the README)
NOTION_TOKEN=
# Printed by scripts/setup_notion_sandbox.py (a database ID or full Notion URL)
NOTION_TASKS_DATABASE_ID=
# Optional, if your database's columns are named differently (defaults shown)
# NOTION_ASSIGNEE_PROPERTY=Assignee
# NOTION_STATUS_PROPERTY=Status
# NOTION_DUE_PROPERTY=Due
# NOTION_DONE_STATUSES=Done
# NOTION_SYNC_SECONDS=120
