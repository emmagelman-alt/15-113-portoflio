# Copy to .env for local development. Never commit .env.
APP_ENV=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
DATABASE_URL=sqlite:///./dashboard.db
BASE_URL=http://localhost:8000

# Microsoft Entra ID app registration (ask Andean IT; see README)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: comma-separated
ALLOWED_EMAIL_DOMAINS=
ADMIN_EMAILS=

# Local only: lets you sign in without Microsoft while developing
DEV_LOGIN=1

# Slack app (see slack-manifest.yml and the README)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Socket Mode token (xapp-...), local development only
SLACK_APP_TOKEN=

# Notion internal integration (see the README)
NOTION_TOKEN=
NOTION_TASKS_DATABASE_ID=
